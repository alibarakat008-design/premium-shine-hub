// ============================================
// SEGMENTA��O DE CANAIS
// Cada venda vem de um canal distinto.
// B2B s� v� contas vinculadas dele (marketplace).
// Admin v� varejo (site B2C + WhatsApp) separado.
// ============================================

enum channel_type {
  marketplace       // ML, Shopee, Amazon � vinculado a B2B
  varejo_site       // Site B2C pr�prio (LIURAESSENCE)
  varejo_whatsapp   // Vendas diretas via WhatsApp
  b2b               // Vendas pra lojistas via plataforma B2B
  atacado           // Vendas em grande quantidade
  outros
}

model b2b_invites {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email           String   @db.VarChar(255)
  nome            String?  @db.VarChar(255)
  empresa         String?  @db.VarChar(255)
  token           String   @unique @db.VarChar(100)
  enviado_por     String?  @db.Uuid // user_id do admin que enviou
  mensagem        String?  @db.Text
  plano           b2b_plano @default(basic)
  status          invite_status @default(pendente)
  expira_em       DateTime @db.Timestamp(6)
  aceito_em       DateTime? @db.Timestamp(6)
  aceito_por      String?  @db.Uuid // b2b_client_id que aceitou
  ip_aceito       String?  @db.VarChar(45)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([email], map: "idx_b2b_invites_email")
  @@index([token], map: "idx_b2b_invites_token")
  @@index([status], map: "idx_b2b_invites_status")
}

enum invite_status {
  pendente
  aceito
  expirado
  revogado
}

// ============================================================
// EQUIPE / COLABORADORES
// ============================================================

model equipe {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome          String    @db.VarChar(255)
  cargo         String?   @db.VarChar(100)
  foto_url      String?   @db.VarChar(500)
  telefone      String?   @db.VarChar(30)
  email         String?   @db.VarChar(255)
  data_nascimento DateTime? @db.Date
  data_admissao DateTime?  @db.Date
  salario_base  Decimal?  @default(0) @db.Decimal(10, 2)
  ativo         Boolean   @default(true)
  observacao    String?   @db.Text
  company_id    String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  pontos        equipe_ponto[]
  salarios      equipe_salarios[]
  pagamentos    equipe_pagamentos[]

  @@index([company_id], map: "idx_equipe_company")
  @@index([ativo], map: "idx_equipe_ativo")
  @@index([data_nascimento], map: "idx_equipe_nascimento")
}

model equipe_ponto {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  equipe_id     String        @db.Uuid
  tipo          ponto_tipo    @default(entrada)
  data_hora     DateTime      @db.Timestamp(6)
  foto_url      String?       @db.VarChar(500)
  observacao    String?       @db.Text
  registrado_por String?       @db.VarChar(255)
  company_id    String?       @db.Uuid
  created_at    DateTime?     @default(now()) @db.Timestamp(6)

  equipe        equipe        @relation(fields: [equipe_id], references: [id], onDelete: Cascade)

  @@index([equipe_id], map: "idx_equipe_ponto_equipe")
  @@index([data_hora], map: "idx_equipe_ponto_data")
}

model equipe_salarios {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  equipe_id     String    @db.Uuid
  mes           Int
  ano           Int
  salario_base  Decimal   @default(0) @db.Decimal(10, 2)
  bonificacao   Decimal   @default(0) @db.Decimal(10, 2)
  descontos     Decimal   @default(0) @db.Decimal(10, 2)
  salario_liquido Decimal @default(0) @db.Decimal(10, 2)
  observacao    String?   @db.Text
  pago_em       DateTime? @db.Date
  pago          Boolean   @default(false)
  company_id    String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  equipe        equipe    @relation(fields: [equipe_id], references: [id], onDelete: Cascade)

  @@unique([equipe_id, mes, ano], map: "uq_equipe_salario_mes_ano")
  @@index([equipe_id], map: "idx_equipe_salarios_equipe")
}

model equipe_pagamentos {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  equipe_id        String         @db.Uuid
  tipo             pagamento_tipo  @default(vale)
  valor            Decimal         @db.Decimal(10, 2)
  data_pagamento   DateTime       @db.Date
  referencia_mes   Int?
  referencia_ano   Int?
  observacao       String?        @db.Text
  registrado_por   String?        @db.VarChar(255)
  company_id       String?        @db.Uuid
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?      @default(now()) @db.Timestamp(6)

  equipe           equipe         @relation(fields: [equipe_id], references: [id], onDelete: Cascade)

  @@index([equipe_id], map: "idx_equipe_pagamentos_equipe")
  @@index([data_pagamento], map: "idx_equipe_pagamentos_data")
  @@index([referencia_mes], map: "idx_equipe_pagamentos_mes")
}

enum ponto_tipo {
  entrada
  saida
  pausa
}

enum pagamento_tipo {
  salario
  vale
  bonus
  decimo_terceiro
  ferias
  outro
}

// ─── MÓDULO PROMOÇÕES ML ──────────────────────────────────────────────────────

model promo_scenarios {
  id                     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_name           String    @db.VarChar(255)
  mlb                    String    @db.VarChar(50)
  max_seller_discount_pct Decimal? @db.Decimal(5, 2)
  min_sale_price         Decimal? @db.Decimal(10, 2)
  min_net_receivable     Decimal? @db.Decimal(10, 2)
  activation_mode        String   @default("conservative") @db.VarChar(20) // conservative | aggressive
  active                 Boolean  @default(false)
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @default(now()) @db.Timestamp(6)

  history promo_scenario_history[]
  latest_query promo_latest_queries?
  simulations promo_simulations[]

  @@unique([mlb], map: "uq_promo_scenario_mlb")
}

model promo_scenario_history {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  scenario_id     String    @db.Uuid
  event_type      String    @db.VarChar(50) // scenario_created | criterion_added | criterion_changed | criterion_removed | mode_changed | activated | deactivated | mlb_changed | scenario_duplicated
  old_values      Json?
  new_values      Json?
  source_scenario_id String? @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamp(6)

  scenario promo_scenarios @relation(fields: [scenario_id], references: [id], onDelete: Cascade)

  @@index([scenario_id], map: "idx_promo_history_scenario")
}

model promo_latest_queries {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  scenario_id      String    @unique @db.Uuid
  ml_user_id       String?   @db.VarChar(50)
  mlb_at_query     String?   @db.VarChar(50)
  raw_payload      Json?
  normalized_data  Json?
  fetched_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  scenario promo_scenarios @relation(fields: [scenario_id], references: [id], onDelete: Cascade)

  @@index([scenario_id], map: "idx_promo_latest_query_scenario")
}

model promo_simulations {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  scenario_id          String    @db.Uuid
  ml_user_id           String?   @db.VarChar(50)
  mlb_at_simulation    String?   @db.VarChar(50)
  product_name_at_sim  String?   @db.VarChar(255)
  promotion_id         String?   @db.VarChar(100)
  promotion_type       String?   @db.VarChar(50)
  promotion_snapshot   Json?
  scenario_snapshot    Json?
  simulation_result   String?   @db.VarChar(30) // can_join | cannot_join | inconclusive
  seller_pct           Decimal?  @db.Decimal(10, 4)
  sale_price           Decimal?  @db.Decimal(10, 2)
  net_receivable       Decimal?  @db.Decimal(10, 2)
  decision_reasons     Json?
  missing_fields       Json?
  cumulative_effects  Json?
  created_at           DateTime? @default(now()) @db.Timestamp(6)

  scenario promo_scenarios @relation(fields: [scenario_id], references: [id], onDelete: Cascade)

  @@index([scenario_id], map: "idx_promo_simulations_scenario")
}

// ─── CONTAS A PAGAR ─────────────────────────────────────────────────────────────

model expenses {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  description   String    @db.VarChar(255)
  amount        Decimal   @db.Decimal(10, 2)
  category_type String    @db.VarChar(20)  // fixed | variable
  category      String    @db.VarChar(50)   // aluguel | salario | luz | internet | marketing | insumos | fretes | impostos | comissoes | outros
  due_date      DateTime  @db.Date
  paid_date     DateTime? @db.Date
  status        String    @default("pending") @db.VarChar(20)  // pending | paid | cancelled
  recurrence    String    @default("monthly") @db.VarChar(20)  // one_time | monthly | yearly
  notes        String?   @db.Text
  company_id   String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  @@index([category_type], map: "idx_expenses_type")
  @@index([status], map: "idx_expenses_status")
  @@index([due_date], map: "idx_expenses_due_date")
  @@index([company_id], map: "idx_expenses_company")
}

model folhaControle {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigo          String    @db.VarChar(100)    // código de rastreio extraído do PDF
  sku             String?   @db.VarChar(100)    // SKU detectado (opcional)
  nome            String?   @db.VarChar(255)     // nome do produto (opcional)
  quantidade      Int       @default(1)
  arquivo_origem  String?   @db.VarChar(255)     // nome do arquivo de origem
  data_upload    DateTime? @db.Timestamp(6)
  status          String    @default("pendente") @db.VarChar(20)  // pendente | separado | entregue
  responsavel     String?   @db.VarChar(100)    // quem separou/entregou
  observacao      String?   @db.Text
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([status], map: "idx_folha_status")
  @@index([codigo], map: "idx_folha_codigo")
  @@index([responsavel], map: "idx_folha_responsavel")
  @@index([data_upload], map: "idx_folha_data")
}
