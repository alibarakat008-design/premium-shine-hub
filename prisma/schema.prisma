generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model affiliate_links {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  afiliado_id     String?   @db.Uuid
  product_id      String?   @db.Uuid
  slug            String    @unique @db.VarChar(50)
  url_completa    String?
  cliques         Int?      @default(0)
  vendas          Int?      @default(0)
  comissao_gerada Decimal?  @default(0) @db.Decimal(10, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users?    @relation(fields: [afiliado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products        products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model api_keys {
  id              String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome            String     @db.VarChar(255)
  descricao       String?
  company_id      String?    @db.Uuid
  key             String     @unique @db.VarChar(255)
  scopes          String[]
  allowed_origins String[]
  ativa           Boolean?   @default(true)
  ultimo_uso      DateTime?  @db.Timestamp(6)
  expira_em       DateTime?  @db.Timestamp(6)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  updated_at      DateTime?  @default(now()) @db.Timestamp(6)
  companies       companies? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model audit_log {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String?   @db.Uuid
  acao             String?   @db.VarChar(100)
  tabela           String?   @db.VarChar(50)
  registro_id      String?   @db.Uuid
  dados_anteriores Json?
  dados_novos      Json?
  ip_address       String?   @db.Inet
  user_agent       String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_created")
  @@index([user_id], map: "idx_audit_user")
}

model brands {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome              String            @unique @db.VarChar(100)
  descricao         String?
  logo_url          String?
  ativa             Boolean?          @default(true)
  margem_minima_pct Decimal?          @default(20.00) @db.Decimal(5, 2)
  is_marca_propria  Boolean?          @default(false)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  pricing_rules     pricing_rules[]
  products          products[]
  sales_forecasts   sales_forecasts[]
}

model cashflow {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id         String?             @db.Uuid
  tipo               cashflow_type
  categoria          String?             @db.VarChar(50)
  descricao          String?
  valor              Decimal             @db.Decimal(10, 2)
  order_id           String?             @db.Uuid
  purchase_id        String?             @db.Uuid
  realizado          Boolean?            @default(false)
  data_prevista      DateTime?           @db.Date
  data_realizada     DateTime?           @db.Date
  conta_bancaria     String?             @db.VarChar(100)
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  companies          companies?          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders             orders?             @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier_purchases supplier_purchases? @relation(fields: [purchase_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id], map: "idx_cashflow_company")
  @@index([data_prevista], map: "idx_cashflow_data")
  @@index([tipo], map: "idx_cashflow_tipo")
}

model categories {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome             String       @db.VarChar(100)
  slug             String       @unique @db.VarChar(100)
  parent_id        String?      @db.Uuid
  icone            String?      @db.VarChar(50)
  ordem            Int?         @default(0)
  ativa            Boolean?     @default(true)
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]
}

model commissions_paid {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String?   @db.Uuid
  tipo            String?   @db.VarChar(20)
  mes_referencia  String?   @db.VarChar(7)
  valor_total     Decimal?  @db.Decimal(10, 2)
  valor_pago      Decimal?  @db.Decimal(10, 2)
  data_pagamento  DateTime? @db.Timestamp(6)
  forma_pagamento String?   @db.VarChar(50)
  comprovante_url String?
  observacao      String?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model companies {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cnpj                 String                 @unique @db.VarChar(18)
  razao_social         String                 @db.VarChar(255)
  nome_fantasia        String?                @db.VarChar(255)
  inscricao_estadual   String?                @db.VarChar(50)
  cnae                 String?                @db.VarChar(20)
  endereco             Json?
  telefone             String?                @db.VarChar(20)
  email                String?                @db.VarChar(255)
  ativa                Boolean?               @default(true)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  api_keys             api_keys[]
  cashflow             cashflow[]
  invoices             invoices[]
  marketplace_accounts marketplace_accounts[]
  orders               orders[]
  price_history        price_history[]
  pricing_rules        pricing_rules[]
  product_prices       product_prices[]
  supplier_purchases   supplier_purchases[]
}

model customers {
  id                      String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome                    String    @db.VarChar(255)
  email                   String?   @db.VarChar(255)
  telefone                String?   @db.VarChar(20)
  cpf                     String?   @db.VarChar(14)
  enderecos               Json?
  endereco_padrao         Json?
  total_pedidos           Int?      @default(0)
  total_gasto             Decimal?  @default(0) @db.Decimal(10, 2)
  ultima_compra           DateTime? @db.Timestamp(6)
  tags                    String[]
  origem_lead             String?   @db.VarChar(50)
  consentimento_marketing Boolean?  @default(false)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  orders                  orders[]
  customer_notes          customer_notes[]
  customer_tags           customer_tags[]
}

model inventory {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id         String?   @unique @db.Uuid
  quantidade_atual   Int       @default(0)
  quantidade_minima  Int?      @default(15)
  quantidade_maxima  Int?
  localizacao_fisica String?   @db.VarChar(100)
  custo_medio        Decimal?  @db.Decimal(10, 2)
  ultima_entrada     DateTime? @db.Timestamp(6)
  ultima_saida       DateTime? @db.Timestamp(6)
  lote               String?   @db.VarChar(50)
  data_fabricacao    DateTime? @db.Date
  data_validade      DateTime? @db.Date
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
  products           products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([product_id], map: "idx_inventory_product")
}

model inventory_movements {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id        String?   @db.Uuid
  tipo              mov_tipo
  quantidade        Int
  estoque_anterior  Int?
  estoque_posterior Int?
  origem_tipo       String?   @db.VarChar(50)
  origem_id         String?   @db.Uuid
  user_id           String?   @db.Uuid
  observacao        String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  products          products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_mov_created")
  @@index([product_id], map: "idx_mov_product")
  @@index([tipo], map: "idx_mov_tipo")
}

model inventory_reservations {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id String?      @db.Uuid
  quantidade Int
  order_id   String?      @db.Uuid
  canal      canal_venda?
  expira_em  DateTime     @db.Timestamp(6)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  products   products?    @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model invoices {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id   String?    @db.Uuid
  order_id     String?    @db.Uuid
  numero       String?    @db.VarChar(50)
  chave_acesso String?    @db.VarChar(50)
  tipo         String?    @db.VarChar(10)
  xml_url      String?
  pdf_url      String?
  status       String?    @db.VarChar(20)
  valor_total  Decimal?   @db.Decimal(10, 2)
  emitida_em   DateTime?  @db.Timestamp(6)
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  companies    companies? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders       orders?    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model marketplace_accounts {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  plataforma           String                 @db.VarChar(50)
  company_id           String?                @db.Uuid
  account_id           String?                @db.VarChar(100)
  nickname             String?                @db.VarChar(255)
  access_token         String?
  refresh_token        String?
  token_expira_em      DateTime?              @db.Timestamp(6)
  ativa                Boolean?               @default(true)
  ultima_sincronizacao DateTime?              @db.Timestamp(6)
  config               Json?
  sync_status          String?                @default("idle") @db.VarChar(20)
  sync_progress        Json?
  sync_result          Json?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  companies            companies?             @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  marketplace_listings marketplace_listings[]
  orders               orders[]
}

model marketplace_listings {
  id                   String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id           String?               @db.Uuid
  account_id           String?               @db.Uuid
  listing_id           String                @db.VarChar(100)
  permalink            String?
  status               String?               @db.VarChar(50)
  preco_atual          Decimal?              @db.Decimal(10, 2)
  preco_original       Decimal?              @db.Decimal(10, 2)
  preco_promocional    Decimal?              @db.Decimal(10, 2)
  promocao_inicio      DateTime?             @db.Timestamp(6)
  promocao_fim         DateTime?             @db.Timestamp(6)
  promocao_tipo        String?               @db.VarChar(30)
  promocao_id_ml       String?               @db.VarChar(50)
  frete_gratis         Boolean?              @default(false)
  envio_full           Boolean?              @default(false)
  etiqueta_impressa    Boolean?              @default(false)
  etiqueta_impressa_em DateTime?             @db.Timestamp(6)
  vendas_total         Int?                  @default(0)
  views_total          Int?                  @default(0)
  stock_disponivel_ml  Int?                  @default(0)
  listing_type         String?               @db.VarChar(30)
  health               Decimal?              @db.Decimal(3, 2)
  condition            String?               @db.VarChar(20)
  modo_compra          String?               @db.VarChar(30)
  categoria_id_ml      String?               @db.VarChar(50)
  data_criacao_ml      DateTime?             @db.Timestamp(6)
  tags                 String[]
  last_sync_at         DateTime?             @default(now()) @db.Timestamp(6)
  marketplace_accounts marketplace_accounts? @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products             products?             @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, vendas_total(sort: Desc)], map: "idx_ml_listings_vendas")
  @@index([account_id, listing_type], map: "idx_ml_listings_type")
  @@unique([account_id, listing_id])
}

model order_items {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id          String?            @db.Uuid
  product_id        String?            @db.Uuid
  sku               String?            @db.VarChar(50)
  nome_produto      String?            @db.VarChar(255)
  foto_url          String?
  quantidade        Int
  preco_unitario    Decimal            @db.Decimal(10, 2)
  preco_total       Decimal            @db.Decimal(10, 2)
  custo_unitario    Decimal?           @db.Decimal(10, 2)
  embalagem_id      String?            @db.Uuid
  packaging_options packaging_options? @relation(fields: [embalagem_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders            orders?            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products          products?          @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
}

model orders {
  id                              String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
order_number                    String?               @unique @db.VarChar(50)
  // pack_id do ML: agrupamento de várias vendas no mesmo envio
  // (o número que aparece na listagem principal do painel ML)
  pack_id                         String?               @db.VarChar(50)
  origem                          order_origem
  company_id                      String?               @db.Uuid
  marketplace_account_id          String?               @db.Uuid
  vendedor_id                     String?               @db.Uuid
  afiliado_id                     String?               @db.Uuid
  customer_id                     String?               @db.Uuid
  status                          order_status?         @default(pendente)
  subtotal                        Decimal               @db.Decimal(10, 2)
  desconto                        Decimal?              @default(0) @db.Decimal(10, 2)
  frete                           Decimal?              @default(0) @db.Decimal(10, 2)
  embalagem                       Decimal?              @default(0) @db.Decimal(10, 2)
  total                           Decimal               @db.Decimal(10, 2)
  custo_total                     Decimal?              @db.Decimal(10, 2)
  lucro_bruto                     Decimal?              @db.Decimal(10, 2)
  lucro_liquido                   Decimal?              @db.Decimal(10, 2)
  endereco_entrega                Json?
  codigo_rastreio                 String?               @db.VarChar(100)
  transportadora                  String?               @db.VarChar(100)
  previsao_entrega                DateTime?             @db.Date
  data_envio                      DateTime?             @db.Timestamp(6)
  data_entrega                    DateTime?             @db.Timestamp(6)
  comissao_seller_pct             Decimal?              @db.Decimal(5, 2)
  comissao_seller_valor           Decimal?              @db.Decimal(10, 2)
  comissao_vendedora_pct          Decimal?              @db.Decimal(5, 2)
  comissao_vendedora_valor        Decimal?              @db.Decimal(10, 2)
  comissao_afiliado_pct           Decimal?              @db.Decimal(5, 2)
  comissao_afiliado_valor         Decimal?              @db.Decimal(10, 2)
  // Valor LÍQUIDO que o Mercado Livre deposita na conta (transaction_amount)
  // = total_amount - comissao_seller_valor - frete - ajustes
  recebimento_liquido             Decimal?              @db.Decimal(10, 2)
  forma_pagamento                 String?               @db.VarChar(50)
  payment_id                      String?               @db.VarChar(100)
  pago_em                         DateTime?             @db.Timestamp(6)
  etiqueta_impressa               Boolean?              @default(false)
  etiqueta_impressa_em            DateTime?             @db.Timestamp(6)
  // Tipo de envio REAL do shipment (vem do /shipments/{id}.logistic_type)
  // 'fulfillment' = FULL, 'self_service' = FLEX, 'me2'/'me1' = Mercado Envios
  tipo_envio                      String?               @db.VarChar(30)
  // Custo FLEX (R$13,90 padrão — editável se carrier for diferente)
  custo_flex                      Decimal?              @db.Decimal(10, 2)
  // Decomposição da comissão ML (pra mostrar no painel vendas-ao-vivo):
  // - bonus_envio_valor: base_cost - list_cost do shipment (estorno "bônus por envio")
  // - bonus_cupom_valor: cupom + bônus implícito (estorno "descontos e bônus")
  // - tarifa_pct_valor: tarifa cheia de 12% (= total * 0.12)
  // - tarifa_fixa_valor: custo fixo ML (= tarifa_bruta - pct)
  bonus_envio_valor               Decimal?              @db.Decimal(10, 2)
  bonus_cupom_valor               Decimal?              @db.Decimal(10, 2)
  tarifa_pct_valor                Decimal?              @db.Decimal(10, 2)
  tarifa_fixa_valor               Decimal?              @db.Decimal(10, 2)
  // Total pago pelo buyer (vem do payments[0].total_paid_amount) — inclui cupons/estornos
  // Diferença entre total_paid_amount e transaction_amount = bônus total devolvido pelo ML
  total_paid_amount               Decimal?              @db.Decimal(10, 2)
  created_at                      DateTime?             @default(now()) @db.Timestamp(6)
  updated_at                      DateTime?             @default(now()) @db.Timestamp(6)
  cashflow                        cashflow[]
  invoices                        invoices[]
  order_items                     order_items[]
  users_orders_afiliado_idTousers users?                @relation("orders_afiliado_idTousers", fields: [afiliado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies                       companies?            @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                       customers?            @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  marketplace_accounts            marketplace_accounts? @relation(fields: [marketplace_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_orders_vendedor_idTousers users?                @relation("orders_vendedor_idTousers", fields: [vendedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id], map: "idx_orders_company")
  @@index([created_at], map: "idx_orders_created")
  @@index([customer_id], map: "idx_orders_customer")
  @@index([origem], map: "idx_orders_origem")
  @@index([status], map: "idx_orders_status")
  @@index([vendedor_id], map: "idx_orders_vendedor")
}

model packaging_options {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome          String        @db.VarChar(100)
  descricao     String?
  foto_url      String?
  custo         Decimal       @db.Decimal(10, 2)
  preco_cliente Decimal       @db.Decimal(10, 2)
  margem        Decimal?      @default(dbgenerated("(preco_cliente - custo)")) @db.Decimal(10, 2)
  estoque       Int?          @default(0)
  ativo         Boolean?      @default(true)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  order_items   order_items[]
}

model price_history {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id String?      @db.Uuid
  canal      canal_venda?
  company_id String?      @db.Uuid
  preco      Decimal      @db.Decimal(10, 2)
  motivo     String?      @db.VarChar(100)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  companies  companies?   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products   products?    @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_price_history_created")
  @@index([product_id], map: "idx_price_history_product")
}

model product_promotions {
  id                  String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id          String?    @db.Uuid
  nome                String?    @db.VarChar(100)
  descricao           String?
  tipo                String?    @default("percentage") @db.VarChar(20)
  desconto            Decimal    @db.Decimal(10, 2)
  preco_original      Decimal?   @db.Decimal(10, 2)
  preco_promocional   Decimal?   @db.Decimal(10, 2)
  data_inicio         DateTime?  @db.Timestamp(6)
  data_fim            DateTime?  @db.Timestamp(6)
  status              String?    @default("ativa") @db.VarChar(20)
  promocao_id_ml      String?    @db.VarChar(100)
  created_at          DateTime?  @default(now()) @db.Timestamp(6)
  products            products?  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_promotions_product")
  @@index([status], map: "idx_product_promotions_status")
}

model product_bundle_items {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bundle_id     String?  @db.Uuid
  product_id    String?  @db.Uuid
  quantidade    Int      @default(1)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  products      products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_bundles product_bundles? @relation(fields: [bundle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bundle_id], map: "idx_bundle_items_bundle")
  @@index([product_id], map: "idx_bundle_items_product")
}

model product_bundles {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome          String   @db.VarChar(100)
  descricao     String?
  sku           String?  @unique @db.VarChar(50)
  ativo         Boolean? @default(true)
  preco_venda   Decimal? @db.Decimal(10, 2)
  custo_total   Decimal? @db.Decimal(10, 2)
  margem_pct    Decimal? @db.Decimal(5, 2)
  estoque_virtual Int?   @default(0)
  items         product_bundle_items[]
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model customer_tags {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id  String?  @db.Uuid
  tag          String   @db.VarChar(50)
  cor          String?  @db.VarChar(20)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  customers    customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_customer_tags_customer")
}

model customer_notes {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id  String?  @db.Uuid
  nota         String
  autor        String?  @db.VarChar(100)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  customers    customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_customer_notes_customer")
}

model smart_alerts {
