model cost_categories {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome       String   @db.VarChar(100)
  tipo       String   @db.VarChar(20) // fixo | variavel | imposto | investimento
  icone      String?  @db.VarChar(50)
  cor        String?  @db.VarChar(20)
  ordem      Int?     @default(0)
  ativa      Boolean? @default(true)
  company_id String?  @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)

  costs monthly_costs[]

  @@index([company_id], map: "idx_cost_categories_company")
}

model monthly_costs {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  category_id String   @db.Uuid
  company_id  String?  @db.Uuid
  // Referência ao mês/ano
  ano         Int
  mes         Int      // 1-12
  descricao   String?  @db.VarChar(255)
  valor       Decimal  @db.Decimal(10, 2)
  // Snapshot do nome da categoria (pra histórico)
  categoria_nome String? @db.VarChar(100)
  pago_em     DateTime? @db.Date
  observacoes String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  category cost_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([category_id, ano, mes, descricao])
  @@index([ano, mes], map: "idx_monthly_costs_periodo")
  @@index([company_id], map: "idx_monthly_costs_company")
}

