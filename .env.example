# =====================================================
# VARIÁVEIS DE AMBIENTE — Premium Shine Hub
# =====================================================
# Copie este arquivo para .env.local e preencha com
# suas credenciais reais

# ===== BANCO DE DADOS (Supabase ou local) =====
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"

# ===== AUTENTICAÇÃO =====
# Gere uma string aleatória de 32+ caracteres
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-uma-string-aleatoria-segura-de-32-chars"

# ===== CRON JOBS =====
# Outro token seguro para o Vercel Cron autenticar
CRON_SECRET="outro-token-seguro-para-cron-32-chars"

# ===== MERCADO LIVRE =====
ML_CLIENT_ID="seu_client_id_do_app_ml"
ML_CLIENT_SECRET="seu_client_secret_do_app_ml"
ML_REDIRECT_URI="http://localhost:3000/api/ml/callback"

# ===== SHOPEE =====
SHOPEE_PARTNER_ID="seu_partner_id"
SHOPEE_PARTNER_KEY="sua_partner_key_32_caracteres"
SHOPEE_REDIRECT_URI="http://localhost:3000/api/shopee/callback"

# ===== CLOUDFLARE R2 (fotos de produtos) =====
R2_ACCOUNT_ID="seu_account_id_cloudflare"
R2_ACCESS_KEY_ID="sua_access_key"
R2_SECRET_ACCESS_KEY="sua_secret_key"
R2_BUCKET="premiumshine-fotos"
R2_PUBLIC_URL="https://fotos.seudominio.com.br"

# ===== ASAAS (PIX e cartão) =====
# sandbox ou production
ASAAS_ENV="sandbox"
ASAAS_API_KEY="$aact_YTU5YTEzNzlkY2NmUjM4MWY5N2VkMTM0..."
ASAAS_WEBHOOK_TOKEN="seu_token_webhook_aqui"

# ===== FOCUS NFe (nota fiscal) =====
# homologation (teste) ou production
FOCUS_NFE_ENV="homologation"
FOCUS_NFE_TOKEN="seu_token_focus_nfe"

# ===== GOOGLE DRIVE (DRE mensal em PDF) =====
GOOGLE_DRIVE_DRE_FOLDER_ID="id_da_pasta_no_drive"
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@...iam.gserviceaccount.com"}'

# ===== CONFIGURAÇÃO DE FRETE =====
ORIGEM_CEP="01310100"
